VITE_API_URL=http://localhost:5000/api

# Optional: Google Maps JavaScript API key.
# When set, the app renders Google Maps; leave empty to use Leaflet/OpenStreetMap.
# Get a key at https://console.cloud.google.com → enable "Maps JavaScript API" →
# create an API key and restrict it to http://localhost:5173/* (and your domain).
VITE_GOOGLE_MAPS_API_KEY=
