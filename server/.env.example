# ---- ChargeSense API server ----
# Port the Express API listens on
PORT=5000

# MongoDB connection string.
# Local MongoDB (default):        mongodb://127.0.0.1:27017/chargesense
# MongoDB Atlas (cloud) example:  mongodb+srv://user:pass@cluster.mongodb.net/chargesense
MONGODB_URI=mongodb://127.0.0.1:27017/chargesense

# Secret used to sign JWT auth tokens. CHANGE THIS in any real deployment.
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d

# URL of the frontend (used for CORS allow-list)
CLIENT_URL=http://localhost:5173

# ---- Optional: zero-setup in-memory MongoDB ----
# If you do not want to install MongoDB, run `npm run mongo:memory` (in server/)
# which starts a REAL mongod on the port/path below and keeps it alive.
MEMORY_DB_PORT=27017
MEMORY_DB_PATH=.data/mongodb
